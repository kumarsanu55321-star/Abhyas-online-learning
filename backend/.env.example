# Copy this file to backend/.env. Supabase URL and anon key match the VITE_ values in the root .env.local.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Configure one provider. Keep these keys on the backend only.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# AI_PROVIDER=groq
# GROQ_API_KEY=

# Optional model overrides
# GEMINI_MODEL=gemini-3.6-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# YouTube Data API v3 key for real video discovery (keep the value in backend/.env)
YOUTUBE_API_KEY=
